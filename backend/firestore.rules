rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Verify admin status from 'users' collection
      // Document must exist, have role 'admin', and enabled 'true'
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isAuthenticated() && 
             userDoc != null && 
             userDoc.data.role == "admin" && 
             userDoc.data.enabled == true;
    }
    
    function validVote() {
      let data = request.resource.data;
      return data.keys().hasAll(['surveyId', 'questionId', 'answerHash', 'timestamp']) &&
             data.surveyId is string &&
             data.answerHash is string;
    }
    
    function validResponse() {
      let data = request.resource.data;
      return data.keys().hasAll(['surveyId', 'answers', 'timestamp']) &&
             data.surveyId is string &&
             data.answers is map &&
             data.timestamp is number;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Admins can read all users (to manage them)
      allow read: if isAdmin();
      // Only Admins can write (create/update users) - MANUAL BOOTSTRAP REQUIRED INITIALLY
      allow write: if isAdmin();
    }

    // ==========================================
    // SURVEYS COLLECTION
    // ==========================================
    match /surveys/{surveyId} {
      // Public: Read only if published
      // Admin: Read all
      allow read: if (resource.data.isPublished == true) || isAdmin();
      
      // Admin only: Create, Update, Delete
      allow write: if isAdmin();
      
      match /questions/{questionId} {
        // Inherit read access from parent survey? 
        // We need to check parent's isPublished status.
        allow read: if (get(/databases/$(database)/documents/surveys/$(surveyId)).data.isPublished == true) || isAdmin();
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // VOTES & RESPONSES (User App)
    // ==========================================
    match /votes/{voteId} {
      allow read: if false; // Anonymous
      allow create: if validVote();
      allow update, delete: if false;
    }
    
    match /responses/{responseId} {
      allow read: if false;
      allow create: if validResponse();
      allow update, delete: if false;
    }
    
    match /participants/{participantId} {
      // Only authenticated users can read (they need to register)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    match /results/{surveyId} {
      // Only admin or survey creator can read results
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
